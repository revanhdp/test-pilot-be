NODE_ENV=development
PORT=4001

# Matches docker-compose.yml (host port 5433)
DATABASE_URL=postgresql://testpilot:testpilot@localhost:5433/testpilot?schema=public

# Public origin of the Nuxt app — used for CORS and password-reset links
APP_URL=http://localhost:4000

SESSION_TTL_DAYS=14

# Screenshots and other artifacts (relative to backend/)
STORAGE_DIR=./storage

# Test runner
RUNNER_CONCURRENCY=1
BROWSER_HEADLESS=true
STEP_TIMEOUT_MS=10000
TEST_TIMEOUT_MS=120000
