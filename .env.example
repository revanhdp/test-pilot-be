NODE_ENV=development
PORT=4001

# Matches docker-compose.yml (host port 5433)
DATABASE_URL=postgresql://testpilot:testpilot@localhost:5433/testpilot?schema=public

# Public origin of the Nuxt app — used for CORS and to check the Clerk token's origin
APP_URL=http://localhost:4000

# Clerk (dashboard.clerk.com → API keys). The matching publishable key goes in the web app.
CLERK_SECRET_KEY=sk_test_...

# Screenshots and other artifacts (relative to backend/)
STORAGE_DIR=./storage

# Test runner
RUNNER_CONCURRENCY=1
BROWSER_HEADLESS=true
STEP_TIMEOUT_MS=10000
TEST_TIMEOUT_MS=120000

# AI test generation (optional). A free Groq key from console.groq.com; do not
# attach a payment method if you want the free limits to stay hard limits.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Per user, in-memory
AI_GENERATIONS_PER_HOUR=10
